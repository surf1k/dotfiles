class BlitzQuizApp(Gtk.Application):
    def __init__(self, total_questions=10):
        super().__init__(application_id="dev.ym1co.study.blitz")
        self.total_questions = total_questions
        self.current_idx = 0
        self.score = 0
        self.streak = 0
        self.max_streak = 0
        self.start_time = 0
        self.window = None

    def do_activate(self):
        if not os.path.exists(CURRICULUM_FILE):
            print("Curriculum not found!")
            self.quit()
            return

        with open(CURRICULUM_FILE, "r", encoding="utf-8") as f:
            self.curriculum = json.load(f)

        self.prev_workspace = get_current_focused_workspace()
        switch_to_study_environment()
        open_obsidian_note(SCRATCHPAD_NOTE)
        trigger_ambient_music()

        # Build list of questions
        self.questions = []
        for _ in range(self.total_questions):
            if ProceduralTaskGenerator and random.random() < 0.30:
                self.questions.append(ProceduralTaskGenerator.get_random_task())
            else:
                self.questions.append(random.choice(self.curriculum))

        # Main GTK4 Window (Аккуратное плавающее окно)
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("⚡ Кросс-Опрос Блиц (10 вопросов)")
        self.window.set_default_size(800, 680)
        self.window.set_modal(True)
        self.window.set_resizable(False)

        self.window.connect("close-request", self.on_close_request)

        key_controller = Gtk.EventControllerKey.new()
        key_controller.connect("key-pressed", self.on_key_pressed)
        self.window.add_controller(key_controller)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_STR.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.outer_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        self.scroller.set_child(self.outer_box)
        self.window.set_child(self.scroller)
        self.window.present()

        self.render_current_question()

    def render_current_question(self):
        # Clear outer box
        child = self.outer_box.get_first_child()
        while child:
            next_child = child.get_next_sibling()
            self.outer_box.remove(child)
            child = next_child

        if self.current_idx >= len(self.questions):
            self.render_summary()
            return

        q = self.questions[self.current_idx]
        vault_file = q.get("vault_file")
        if vault_file:
            open_obsidian_note(vault_file)

        card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card_box.add_css_class("card-box")

        # 1. Header Badges
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        blitz_badge = Gtk.Label(label="⚡ БЛИЦ РАУНД")
        blitz_badge.add_css_class("badge-blitz")

        prog_badge = Gtk.Label(label=f"🎯 Вопрос {self.current_idx + 1} из {self.total_questions}")
        prog_badge.add_css_class("badge-progress")

        score_badge = Gtk.Label(label=f"⭐ Счет: {self.score}")
        score_badge.add_css_class("badge-score")

        streak_badge = Gtk.Label(label=f"🔥 Серия: {self.streak}")
        streak_badge.add_css_class("badge-streak")

        header_box.append(blitz_badge)
        header_box.append(prog_badge)
        header_box.append(score_badge)
        header_box.append(streak_badge)
        card_box.append(header_box)

        # 2. Scratchpad info
        scratch_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        scratch_box.add_css_class("scratchpad-info-box")
        scratch_label = Gtk.Label()
        subj = q.get("subject", "Предмет")
        topic = q.get("topic", "")
        scratch_label.set_markup(f"📖 <b>[{escape_text(subj)}: {escape_text(topic)}]</b> Конспект и черновик открыты в Obsidian на 2-м экране!")
        scratch_label.set_wrap(True)
        scratch_label.set_xalign(0.0)
        scratch_box.append(scratch_label)
        card_box.append(scratch_box)

        # 3. Question text
        q_label = Gtk.Label(label=q["question"])
        q_label.set_wrap(True)
        q_label.set_xalign(0.0)
        q_label.add_css_class("question-text")
        card_box.append(q_label)

        # 4. Options buttons
        self.option_buttons = []
        letters = ["A", "B", "C", "D"]
        for idx, opt_text in enumerate(q.get("options", [])):
            btn = Gtk.Button()
            btn.add_css_class("option-btn")
            lbl = Gtk.Label(label=f"{letters[idx]}.  {opt_text}")
            lbl.set_xalign(0.0)
            lbl.set_wrap(True)
            btn.set_child(lbl)
            btn.connect("clicked", self.on_option_clicked, idx)
            card_box.append(btn)
            self.option_buttons.append(btn)

        # 5. Feedback Box
        self.feedback_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.feedback_box.add_css_class("explanation-box")
        self.feedback_box.set_visible(False)
        
        self.feedback_title = Gtk.Label()
        self.feedback_title.set_xalign(0.0)
        self.feedback_label = Gtk.Label()
        self.feedback_label.set_wrap(True)
        self.feedback_label.set_xalign(0.0)

        self.feedback_box.append(self.feedback_title)
        self.feedback_box.append(self.feedback_label)
        card_box.append(self.feedback_box)

        # 6. Next Question Button
        btn_label = "Следующий вопрос →" if self.current_idx + 1 < self.total_questions else "Посмотреть результаты 🏆"
        self.next_btn = Gtk.Button(label=btn_label)
        self.next_btn.add_css_class("next-btn")
        self.next_btn.set_visible(False)
        self.next_btn.connect("clicked", self.on_next_clicked)
        card_box.append(self.next_btn)

        self.outer_box.append(card_box)
        self.question_start_time = time.time()

    def on_option_clicked(self, button, chosen_idx):
        q = self.questions[self.current_idx]
        correct_idx = q.get("correct_index", 0)
        is_correct = (chosen_idx == correct_idx)
        elapsed = round(time.time() - getattr(self, "question_start_time", time.time()), 1)

        if AnalyticsTracker:
            AnalyticsTracker.record_answer(
                task_id=q.get("id", f"gen_{int(time.time())}"),
                subject=q.get("subject"),
                topic=q.get("topic"),
                is_correct=is_correct,
                time_spent=elapsed,
                session_type="blitz"
            )

        for btn in self.option_buttons:
            btn.set_sensitive(False)

        if chosen_idx == correct_idx:
            self.score += 1
            self.streak += 1
            self.max_streak = max(self.max_streak, self.streak)
            button.add_css_class("option-correct")
            self.feedback_title.set_markup("<span foreground='#78c45d'><b>🎉 ВЕРНО! (+1 балл)</b></span>")
        else:
            self.streak = 0
            button.add_css_class("option-wrong")
            self.option_buttons[correct_idx].add_css_class("option-correct")
            self.feedback_title.set_markup("<span foreground='#d4574a'><b>❌ НЕВЕРНО!</b></span>")

        self.feedback_label.set_text(q.get("explanation", ""))
        self.feedback_box.set_visible(True)
        self.next_btn.set_visible(True)

    def on_next_clicked(self, button):
        self.current_idx += 1
        self.render_current_question()

    def render_summary(self):
        card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card_box.add_css_class("card-box")

        pct = int((self.score / max(1, self.total_questions)) * 100)

        title = Gtk.Label()
        title.set_markup(f"<span font_size='22pt'><b>🏆 ИТОГИ БЛИЦ-РАУНДА</b></span>")
        title.set_halign(Gtk.Align.CENTER)
        card_box.append(title)

        score_lbl = Gtk.Label()
        score_lbl.set_markup(f"<span font_size='26pt' foreground='#dec07e'><b>{self.score} / {self.total_questions} ({pct}%)</b></span>")
        score_lbl.set_halign(Gtk.Align.CENTER)
        card_box.append(score_lbl)

        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        info_box.add_css_class("scratchpad-info-box")

        streak_lbl = Gtk.Label()
        streak_lbl.set_markup(f"🔥 <b>Максимальная серия (Streak):</b> {self.max_streak}")
        streak_lbl.set_xalign(0.0)
        info_box.append(streak_lbl)

        verdict_lbl = Gtk.Label()
        if pct >= 90:
            verdict_lbl.set_markup("👑 <b>ОЦЕНКА:</b> Божественный уровень! Знания по всем 13 предметам на высоте.")
        elif pct >= 70:
            verdict_lbl.set_markup("🔥 <b>ОЦЕНКА:</b> Отличный результат! Мозг работает на полной мощности.")
        else:
            verdict_lbl.set_markup("📖 <b>ОЦЕНКА:</b> Хорошая тренировка. Повтори слабые темы в Obsidian.")
        verdict_lbl.set_xalign(0.0)
        info_box.append(verdict_lbl)

        card_box.append(info_box)

        finish_btn = Gtk.Button(label="Завершить Блиц →")
        finish_btn.add_css_class("next-btn")
        finish_btn.connect("clicked", self.on_finish_clicked)
        card_box.append(finish_btn)

        self.outer_box.append(card_box)

    def on_finish_clicked(self, button):
        close_study_helpers()
        restore_previous_workspace(self.prev_workspace)
        self.window.close()

    def on_close_request(self, window):
        close_study_helpers()
        restore_previous_workspace(self.prev_workspace)
        return False

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.on_finish_clicked(None)
            return True
        return False

def main():
    count = 10
    if len(sys.argv) > 1 and sys.argv[1].isdigit():
        count = int(sys.argv[1])
    app = BlitzQuizApp(total_questions=count)
    app.run([])

if __name__ == "__main__":
    main()
