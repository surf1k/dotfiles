#!/usr/bin/env python3
import sys
import os

# Use rock-solid GL (OpenGL) renderer to prevent Wayland Vulkan swapchain crashes
os.environ["GSK_RENDERER"] = "gl"

import json
import time
import random
import urllib.parse
import subprocess
import gi

gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gdk, GLib

CONFIG_DIR = os.path.expanduser("~/.config/study-daemon")
CURRICULUM_FILE = os.path.join(CONFIG_DIR, "curriculum.json")
SCRATCHPAD_NOTE = "00 🎯 Dashboards & MOCs/✍️ Черновик и Быстрые Заметки.md"

if CONFIG_DIR not in sys.path:
    sys.path.insert(0, CONFIG_DIR)

try:
    from task_generator import ProceduralTaskGenerator
except Exception:
    ProceduralTaskGenerator = None

try:
    from analytics import AnalyticsTracker
except Exception:
    AnalyticsTracker = None

def escape_text(text):
    return GLib.markup_escape_text(str(text))

def get_current_focused_workspace():
    try:
        res = subprocess.run(["niri", "msg", "-j", "workspaces"], capture_output=True, text=True, timeout=1.5)
        if res.returncode == 0:
            workspaces = json.loads(res.stdout)
            for ws in workspaces:
                if ws.get("is_focused"):
                    return ws.get("id") or ws.get("idx")
    except Exception:
        pass
    return None

def switch_to_study_environment():
    try:
        # 1. Switch HDMI-A-1 (Monitor 2) to 'notes' workspace
        subprocess.run(["niri", "msg", "action", "focus-monitor", "HDMI-A-1"], stderr=subprocess.DEVNULL)
        subprocess.run(["niri", "msg", "action", "focus-workspace", "notes"], stderr=subprocess.DEVNULL)
        
        # 2. Switch DP-1 (Monitor 1) to 'study' workspace
        subprocess.run(["niri", "msg", "action", "focus-monitor", "DP-1"], stderr=subprocess.DEVNULL)
        subprocess.run(["niri", "msg", "action", "focus-workspace", "study"], stderr=subprocess.DEVNULL)
    except Exception:
        pass

def restore_previous_workspace(ws_id):
    if ws_id is not None:
        try:
            subprocess.run(["niri", "msg", "action", "focus-monitor", "DP-1"], stderr=subprocess.DEVNULL)
            subprocess.run(["niri", "msg", "action", "focus-workspace", str(ws_id)], stderr=subprocess.DEVNULL)
        except Exception:
            pass

def open_obsidian_note(vault_rel_path):
    if not vault_rel_path:
        return
    try:
        encoded = urllib.parse.quote(vault_rel_path)
        uri = f"obsidian://open?vault=intensive-study-vault&file={encoded}"
        subprocess.Popen(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def close_study_helpers():
    try:
        subprocess.run(["pkill", "-9", "-f", "obsidian"], stderr=subprocess.DEVNULL)
    except Exception:
        pass

def trigger_ambient_music():
    try:
        res = subprocess.run(["playerctl", "--player=ytmdesktop", "play"], capture_output=True, text=True, timeout=1)
        if res.returncode != 0:
            subprocess.Popen(["flatpak", "run", "app.ytmdesktop.ytmdesktop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

CSS_STR = """
window {
    background-color: #0c140e;
    color: #dce7cf;
    font-family: 'Nunito', 'Inter', sans-serif;
}

.card-box {
    background-color: #122016;
    border: 2px solid rgba(222, 192, 126, 0.45);
    border-radius: 22px;
    padding: 30px;
    margin: 10px;
}

.badge-blitz {
    background-color: #3b1e38;
    color: #fca5e8;
    font-size: 14.5px;
    font-weight: 800;
