#!/usr/bin/env python3
import sys
import os

# Rock-solid OpenGL renderer for GTK4 on Wayland
os.environ["GSK_RENDERER"] = "gl"

# Ensure WAYLAND_DISPLAY is set when launched from systemd service
if "WAYLAND_DISPLAY" not in os.environ:
    import glob
    socks = sorted(glob.glob(f"/run/user/{os.getuid()}/wayland-*"), key=os.path.getmtime, reverse=True)
    socks = [s for s in socks if not s.endswith(".lock")]
    if socks:
        os.environ["WAYLAND_DISPLAY"] = os.path.basename(socks[0])

import json
import time
import random
import fcntl
import urllib.parse
import subprocess
import gi

gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gdk, GLib

CONFIG_DIR = os.path.expanduser("~/.config/study-daemon")
CURRICULUM_FILE = os.path.join(CONFIG_DIR, "curriculum.json")
PROGRESS_FILE = os.path.join(CONFIG_DIR, "progress.json")

THINKING_TIME_MATH = 15
WRONG_ANSWER_PENALTY = 90

if CONFIG_DIR not in sys.path:
    sys.path.insert(0, CONFIG_DIR)

try:
    from task_generator import ProceduralTaskGenerator
except Exception:
    ProceduralTaskGenerator = None

try:
    from analytics import AnalyticsTracker
except Exception:
    AnalyticsTracker = None

def ensure_single_popup_instance():
    global lock_file_popup
    lock_file_popup = open("/tmp/study-popup.lock", "w")
    try:
        fcntl.flock(lock_file_popup, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except IOError:
        print("study-popup is already open. Skipping duplicate.")
        sys.exit(0)

def escape_text(text):
    return GLib.markup_escape_text(str(text))

def get_current_focused_workspace():
    try:
        res = subprocess.run(["niri", "msg", "-j", "workspaces"], capture_output=True, text=True, timeout=1.5)
        if res.returncode == 0:
            workspaces = json.loads(res.stdout)
            for ws in workspaces:
                if ws.get("is_focused"):
                    return ws.get("id") or ws.get("idx")
    except Exception:
        pass
    return None

def switch_to_study_workspace():
    try:
        # 1. Switch HDMI-A-1 (Monitor 2) to 'notes' workspace
        subprocess.run(["niri", "msg", "action", "focus-monitor", "HDMI-A-1"], stderr=subprocess.DEVNULL)
        subprocess.run(["niri", "msg", "action", "focus-workspace", "notes"], stderr=subprocess.DEVNULL)
        
        # 2. Switch DP-1 (Monitor 1) to 'study' workspace
        subprocess.run(["niri", "msg", "action", "focus-monitor", "DP-1"], stderr=subprocess.DEVNULL)
        subprocess.run(["niri", "msg", "action", "focus-workspace", "study"], stderr=subprocess.DEVNULL)
    except Exception:
        pass

def restore_previous_workspace(ws_id):
    if ws_id is not None:
        try:
            subprocess.run(["niri", "msg", "action", "focus-monitor", "DP-1"], stderr=subprocess.DEVNULL)
            subprocess.run(["niri", "msg", "action", "focus-workspace", str(ws_id)], stderr=subprocess.DEVNULL)
        except Exception:
            pass

def open_obsidian_note(vault_rel_path):
    if not vault_rel_path:
        return
    try:
        encoded = urllib.parse.quote(vault_rel_path)
        uri = f"obsidian://open?vault=intensive-study-vault&file={encoded}"
        subprocess.Popen(["/home/ym1co/.local/bin/obsidian", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def close_study_helpers():
    try:
        subprocess.run(["pkill", "-15", "-f", "obsidian"], stderr=subprocess.DEVNULL)
    except Exception:
        pass

def trigger_ambient_music():
    try:
        res = subprocess.run(["playerctl", "--player=ytmdesktop", "play"], capture_output=True, text=True, timeout=1)
        if res.returncode != 0:
            subprocess.Popen(["flatpak", "run", "app.ytmdesktop.ytmdesktop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def load_data():
    if not os.path.exists(CURRICULUM_FILE):
        return [], {}
    with open(CURRICULUM_FILE, "r", encoding="utf-8") as f:
        curriculum = json.load(f)
    
    progress = {}
    if os.path.exists(PROGRESS_FILE):
        try:
            with open(PROGRESS_FILE, "r", encoding="utf-8") as f:
                progress = json.load(f)
        except Exception:
            progress = {}
    return curriculum, progress

def save_progress(progress):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(PROGRESS_FILE, "w", encoding="utf-8") as f:
        json.dump(progress, f, ensure_ascii=False, indent=2)

def select_task(curriculum, progress):
    now = time.time()
    DAY_WINDOW = 20 * 3600  # Cooldown: tasks/topics cannot repeat within 20 hours (max 1 per day)
    
    # 1. Collect all topics and task IDs reviewed today
    reviewed_today_ids = set()
    reviewed_today_topics = set()
    recent_subjects = []

    id_to_topic = {q["id"]: q.get("topic", "") for q in curriculum}

    sorted_prog = sorted(progress.items(), key=lambda x: x[1].get("last_reviewed", 0), reverse=True)
    for tid, p in sorted_prog:
        last_rev = p.get("last_reviewed", 0)
        if (now - last_rev) < DAY_WINDOW:
            reviewed_today_ids.add(tid)
            topic = p.get("topic") or id_to_topic.get(tid)
            if topic:
                reviewed_today_topics.add(topic)
        if len(recent_subjects) < 3 and "subject" in p:
            recent_subjects.append(p["subject"])

    # 2. Candidate procedural task types (only those NOT reviewed today)
    available_proc_ids = []
    if ProceduralTaskGenerator:
        available_proc_ids = [t for t in ProceduralTaskGenerator.TASK_TYPES if t not in reviewed_today_ids]

    # 3. Candidate curriculum questions (strictly NOT reviewed today and topic NOT reviewed today)
    curriculum_candidates = [
        q for q in curriculum
        if q["id"] not in reviewed_today_ids and q.get("topic") not in reviewed_today_topics
    ]

    # If all questions have been reviewed today (rare), fallback to spaced-repetition due
    if not curriculum_candidates and not available_proc_ids:
        curriculum_candidates = [q for q in curriculum if progress.get(q["id"], {}).get("next_review", 0) <= now]
        if not curriculum_candidates:
            curriculum_candidates = curriculum

    # 4. Fair Selection: 25% chance for a procedural task (if an unreviewed type is available), 75% for diverse curriculum
    if available_proc_ids and random.random() < 0.25:
        chosen_id = random.choice(available_proc_ids)
        task = ProceduralTaskGenerator.get_task_by_id(chosen_id)
        if task:
            return task, 2

    # 5. Prioritize subjects that were NOT the last subject asked (subject rotation)
    if curriculum_candidates:
        non_recent = [q for q in curriculum_candidates if q.get("subject") not in recent_subjects[:1]]
        pool = non_recent if non_recent else curriculum_candidates
        q = random.choice(pool)
        return q, q.get("phase", 1)

    if available_proc_ids:
        chosen_id = random.choice(available_proc_ids)
        return ProceduralTaskGenerator.get_task_by_id(chosen_id), 2

    return random.choice(curriculum), 1

