class StudyApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.ym1co.study.quiz")
        self.window = None

    def do_activate(self):
        curriculum, progress = load_data()
        if not curriculum:
            print("Curriculum empty!")
            self.quit()
            return
            
        task, phase = select_task(curriculum, progress)
        self.task = task
        self.progress = progress
        self.answered_correctly = False
        self.disabled_wrong_indices = set()
        self.question_start_time = time.time()

        # 1. Рабочий стол
        self.prev_workspace = get_current_focused_workspace()
        switch_to_study_workspace()

        # 2. Авто-открытие темы в Obsidian и запуск YouTube Music на 2-м экране
        vault_note = task.get("vault_file")
        if vault_note:
            open_obsidian_note(vault_note)
        trigger_ambient_music()

        # 3. GUI Окно (Аккуратное плавающее окно)
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("⚡ Обучающий Чекпоинт Знаний (Школьная программа)")
        self.window.set_default_size(800, 680)
        self.window.set_modal(True)
        self.window.set_resizable(False)

        self.window.connect("close-request", self.on_close_request)

        key_controller = Gtk.EventControllerKey.new()
        key_controller.connect("key-pressed", self.on_key_pressed)
        self.window.add_controller(key_controller)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_STR.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.add_css_class("card-box")

        # 1. Header Badges
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        subj = task.get("subject", "Школьная программа")
        subj_badge = Gtk.Label(label=subj)
        subj_badge.add_css_class("badge-subject")
        
        topic_text = task.get("topic", "")
        topic_badge = Gtk.Label(label=f"📖 {topic_text}")
        topic_badge.add_css_class("badge-phase")
        
        tid = task["id"]
        streak = self.progress.get(tid, {}).get("streak", 0)
        streak_badge = Gtk.Label(label=f"🔥 Серия: {streak}")
        streak_badge.add_css_class("badge-streak")

        header_box.append(subj_badge)
        header_box.append(topic_badge)
        header_box.append(streak_badge)
        main_box.append(header_box)

        # 2. Баннер протокола черновика
        paper_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        paper_box.add_css_class("paper-warning-box")
        paper_label = Gtk.Label()
        paper_label.set_markup("✍️ <b>ПРОТОКОЛ ЧЕРНОВИКА:</b> Конспект темы открыт в Obsidian на 2-м экране! Вдумайся и реши на листке.")
        paper_label.set_wrap(True)
        paper_label.set_xalign(0.0)
        paper_box.append(paper_label)
        main_box.append(paper_box)

        # 3. Экспресс-гайд (Только теория и формулы)
        theory_text = task.get("theory_guide", "")
        if theory_text:
            guide_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            guide_box.add_css_class("guide-box")
            guide_title = Gtk.Label()
            guide_title.set_markup(f"<b>💡 Экспресс-гайд по теме «{escape_text(topic_text)}»:</b>")
            guide_title.set_xalign(0.0)
            
            guide_label = Gtk.Label(label=theory_text)
            guide_label.set_wrap(True)
            guide_label.set_xalign(0.0)
            
            guide_box.append(guide_title)
            guide_box.append(guide_label)
            main_box.append(guide_box)

        # 4. Разобранный пример
        solved_sample = task.get("solved_example")
        if solved_sample:
            ex_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            ex_box.add_css_class("example-box")
            ex_title = Gtk.Label()
            ex_title.set_markup("<b>📝 Разобранный аналогичный пример:</b>")
            ex_title.set_xalign(0.0)
            
            ex_label = Gtk.Label(label=solved_sample)
            ex_label.set_wrap(True)
            ex_label.set_xalign(0.0)
            
            ex_box.append(ex_title)
            ex_box.append(ex_label)
            main_box.append(ex_box)

        # 5. Текст задания
        q_text = task.get("question", task.get("description", ""))
        q_label = Gtk.Label(label=q_text)
        q_label.set_wrap(True)
        q_label.set_xalign(0.0)
        q_label.add_css_class("question-text")
        main_box.append(q_label)

        # 6. Таймер размышления
        self.timer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.timer_box.add_css_class("timer-box")
        self.timer_label = Gtk.Label()
        self.timer_label.set_xalign(0.0)
        self.timer_box.append(self.timer_label)
        main_box.append(self.timer_box)

        # 7. Варианты ответов
        self.option_buttons = []
        letters = ["A", "B", "C", "D"]
        for idx, opt_text in enumerate(task.get("options", [])):
            btn = Gtk.Button()
            btn.add_css_class("option-btn")
            btn.set_sensitive(False)
            
            lbl = Gtk.Label(label=f"{letters[idx]}.  {opt_text}")
            lbl.set_xalign(0.0)
            lbl.set_wrap(True)
            btn.set_child(lbl)
            
            btn.connect("clicked", self.on_option_clicked, idx)
            main_box.append(btn)
            self.option_buttons.append(btn)

        # 8. Блок обратной связи
        self.feedback_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.feedback_box.add_css_class("explanation-box")
        self.feedback_box.set_visible(False)
        
        self.feedback_title = Gtk.Label()
        self.feedback_title.set_xalign(0.0)
        self.feedback_label = Gtk.Label()
        self.feedback_label.set_wrap(True)
        self.feedback_label.set_xalign(0.0)
        
        self.feedback_box.append(self.feedback_title)
        self.feedback_box.append(self.feedback_label)
        main_box.append(self.feedback_box)

        # 9. Кнопка продолжить
        self.continue_btn = Gtk.Button(label="Продолжить →")
        self.continue_btn.add_css_class("continue-btn")
        self.continue_btn.set_visible(False)
        self.continue_btn.connect("clicked", self.on_continue_clicked)
        main_box.append(self.continue_btn)

        scroller.set_child(main_box)
        self.window.set_child(scroller)
        self.window.present()

        self.start_countdown(THINKING_TIME_MATH, "⏳ Вдумайся и реши на листке. Кнопки разблокируются через", self.unlock_options)

    def start_countdown(self, seconds, prefix_text, on_finish_callback):
        self.remaining_seconds = seconds
        self.countdown_prefix = prefix_text
        self.countdown_callback = on_finish_callback
        self.timer_box.set_visible(True)
        self.update_timer_label()
        self.timer_source_id = GLib.timeout_add_seconds(1, self.on_timer_tick)

    def update_timer_label(self):
        mins = self.remaining_seconds // 60
        secs = self.remaining_seconds % 60
        time_str = f"{mins}:{secs:02d}" if mins > 0 else f"{secs} сек"
        self.timer_label.set_markup(f"<b>{escape_text(self.countdown_prefix)} {time_str}...</b>")

    def on_timer_tick(self):
        self.remaining_seconds -= 1
        if self.remaining_seconds <= 0:
            self.timer_box.set_visible(False)
            if self.countdown_callback:
                self.countdown_callback()
            return False
        self.update_timer_label()
        return True

    def unlock_options(self):
        if not hasattr(self, "option_buttons"):
            return
        for idx, btn in enumerate(self.option_buttons):
            if idx not in self.disabled_wrong_indices:
                btn.set_sensitive(True)

    def on_close_request(self, window):
        if not self.answered_correctly:
            return True
        close_study_helpers()
        restore_previous_workspace(self.prev_workspace)
        return False

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape and not self.answered_correctly:
            return True
        return False

    def on_option_clicked(self, button, chosen_idx):
        correct_idx = self.task.get("correct_index", 0)
        tid = self.task["id"]
        is_correct = (chosen_idx == correct_idx)
        elapsed = round(time.time() - getattr(self, "question_start_time", time.time()), 1)
        
        if AnalyticsTracker:
            AnalyticsTracker.record_answer(
                task_id=tid,
                subject=self.task.get("subject"),
                topic=self.task.get("topic"),
                is_correct=is_correct,
                time_spent=elapsed,
                session_type="checkpoint"
            )

        for btn in self.option_buttons:
            btn.set_sensitive(False)

        if chosen_idx == correct_idx:
            self.answered_correctly = True
            button.add_css_class("option-correct")
            
            p = self.progress.get(tid, {"streak": 0, "reviews": 0})
            p["reviews"] = p.get("reviews", 0) + 1
            p["streak"] = p.get("streak", 0) + 1
            p["last_reviewed"] = time.time()
            p["subject"] = self.task.get("subject", "")
            p["topic"] = self.task.get("topic", "")
            intervals = [3600, 86400, 3*86400, 7*86400, 14*86400, 30*86400]
            idx_int = min(p["streak"] - 1, len(intervals) - 1)
            p["next_review"] = time.time() + intervals[idx_int]
            self.progress[tid] = p
            save_progress(self.progress)

            self.feedback_title.set_markup("<span foreground='#78c45d'><b>🎉 ВЕРНО! Идеально!</b></span>")
            self.feedback_label.set_text(self.task.get("explanation", ""))
            self.feedback_box.set_visible(True)
            self.continue_btn.set_visible(True)
        else:
            button.add_css_class("option-wrong")
            self.disabled_wrong_indices.add(chosen_idx)
            
            p = self.progress.get(tid, {"streak": 0, "reviews": 0})
            p["reviews"] = p.get("reviews", 0) + 1
            p["streak"] = 0
            p["last_reviewed"] = time.time()
            p["subject"] = self.task.get("subject", "")
            p["topic"] = self.task.get("topic", "")
            p["next_review"] = time.time() + 1800
            self.progress[tid] = p
            save_progress(self.progress)

            self.feedback_title.set_markup("<span foreground='#d4574a'><b>❌ НЕВЕРНО! Подумай и перерешай на черновике.</b></span>")
            self.feedback_label.set_text("Верный ответ скрыт. Обрати внимание на конспект в Obsidian на 2-м экране и разобранный пример выше, распиши решение на листке и выбери правильный вариант после окончания таймера.")
            self.feedback_box.set_visible(True)

            self.start_countdown(WRONG_ANSWER_PENALTY, "⏳ Штраф за ошибку: перерешай на черновике. Разблокировка через", self.unlock_options)

    def on_continue_clicked(self, button):
        self.answered_correctly = True
        close_study_helpers()
        restore_previous_workspace(self.prev_workspace)
        self.window.close()

def main():
    ensure_single_popup_instance()
    app = StudyApp()
    app.run(sys.argv)

if __name__ == "__main__":
    main()
