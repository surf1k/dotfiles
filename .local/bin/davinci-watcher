#!/usr/bin/env python3
"""
davinci-watcher:
Background daemon that watches ~/Videos and $HOME for DaVinci Resolve image sequences.
When a render completes (no new frames for 3-5 seconds), it automatically runs
davinci-stitch to produce an MP4 and cleanup the frames.
"""

import os
import sys
import time
import subprocess
from pathlib import Path

WATCH_DIRS = [
    Path.home() / "Videos",
    Path.home(),
]

STITCH_BIN = Path.home() / ".local/bin/davinci-stitch"

def check_dir_for_sequences(d: Path) -> bool:
    if not d.exists():
        return False
    # Look for files ending with digits or digits. like Timeline 1_00216000.
    count = 0
    now = time.time()
    last_mod = 0.0
    for p in d.iterdir():
        if not p.is_file():
            continue
        name = p.name
        # Match pattern like ...0000. or ..._0000.
        if any(name.startswith(pre) for pre in ["Timeline", "Clip", "Render"]) or name.endswith(".dpx"):
            m = p.stat()
            if m.st_size > 100000: # at least 100KB
                count += 1
                if m.st_mtime > last_mod:
                    last_mod = m.st_mtime
    
    # If at least 10 frames exist and no new frame in last 3.5 seconds
    if count >= 10:
        idle_time = now - last_mod
        if 3.0 <= idle_time <= 300.0:
            return True
    return False

def main():
    while True:
        try:
            for d in WATCH_DIRS:
                if check_dir_for_sequences(d):
                    # Trigger stitch
                    subprocess.run([str(STITCH_BIN), str(d)], check=False)
                    time.sleep(2)
        except Exception:
            pass
        time.sleep(2.5)

if __name__ == "__main__":
    main()
