#!/usr/bin/env python3
"""
Roblox Anti-AFK for Linux / Niri / Wayland / XWayland (Sober)
Reliably prevents 20-minute idle kicks in Roblox without switching workspaces or teleporting the user.
Uses X11 XTEST (hardware-level event injection) & cursor positioning directly in XWayland.
"""

import sys
import time
import json
import random
import signal
import argparse
import subprocess
import ctypes
from datetime import datetime
from ctypes import c_void_p, c_ulong, c_int, c_uint, c_char_p, Structure, byref, POINTER

# Enable unbuffered line output for real-time systemd/journalctl logs
try:
    sys.stdout.reconfigure(line_buffering=True)
    sys.stderr.reconfigure(line_buffering=True)
except Exception:
    pass

# Optional uinput fallback
try:
    import evdev
    from evdev import UInput, ecodes as e
    HAVE_UINPUT = True
except ImportError:
    HAVE_UINPUT = False

# X11 structures
class XClassHint(Structure):
    _fields_ = [
        ("res_name", c_char_p),
        ("res_class", c_char_p),
    ]

class XWindowAttributes(Structure):
    _fields_ = [
        ('x', c_int), ('y', c_int),
        ('width', c_int), ('height', c_int),
        ('border_width', c_int),
        ('depth', c_int),
        ('visual', c_void_p),
        ('root', c_ulong),
        ('class', c_int),
        ('bit_gravity', c_int),
        ('win_gravity', c_int),
        ('backing_store', c_int),
        ('backing_planes', c_ulong),
        ('backing_pixel', c_ulong),
        ('save_under', c_int),
        ('colormap', c_ulong),
        ('map_installed', c_int),
        ('map_state', c_int),
        ('all_event_masks', ctypes.c_long),
        ('your_event_mask', ctypes.c_long),
        ('do_not_propagate_mask', ctypes.c_long),
        ('override_redirect', c_int),
        ('screen', c_void_p),
    ]

class X11InputSender:
    def __init__(self):
        try:
            self.x11 = ctypes.CDLL("libX11.so.6")
            self.xtst = ctypes.CDLL("libXtst.so.6")
            self._setup_bindings()
            self.disp = self.x11.XOpenDisplay(None)
            self.root = self.x11.XDefaultRootWindow(self.disp) if self.disp else None
        except Exception:
            self.x11 = None
            self.xtst = None
            self.disp = None
            self.root = None

    def _setup_bindings(self):
        self.x11.XOpenDisplay.argtypes = [c_char_p]
        self.x11.XOpenDisplay.restype = c_void_p
        self.x11.XCloseDisplay.argtypes = [c_void_p]
        self.x11.XCloseDisplay.restype = c_int
        self.x11.XDefaultRootWindow.argtypes = [c_void_p]
        self.x11.XDefaultRootWindow.restype = c_ulong
        self.x11.XQueryTree.argtypes = [c_void_p, c_ulong, POINTER(c_ulong), POINTER(c_ulong), POINTER(POINTER(c_ulong)), POINTER(c_uint)]
        self.x11.XQueryTree.restype = c_int
        self.x11.XGetClassHint.argtypes = [c_void_p, c_ulong, POINTER(XClassHint)]
        self.x11.XGetClassHint.restype = c_int
        self.x11.XFree.argtypes = [c_void_p]
        self.x11.XFree.restype = c_int
        self.x11.XStringToKeysym.argtypes = [c_char_p]
        self.x11.XStringToKeysym.restype = c_ulong
        self.x11.XKeysymToKeycode.argtypes = [c_void_p, c_ulong]
        self.x11.XKeysymToKeycode.restype = ctypes.c_ubyte
        self.x11.XWarpPointer.argtypes = [c_void_p, c_ulong, c_ulong, c_int, c_int, c_uint, c_uint, c_int, c_int]
        self.x11.XWarpPointer.restype = c_int
        self.x11.XSetInputFocus.argtypes = [c_void_p, c_ulong, c_int, c_ulong]
        self.x11.XSetInputFocus.restype = c_int
        self.x11.XGetWindowAttributes.argtypes = [c_void_p, c_ulong, POINTER(XWindowAttributes)]
        self.x11.XGetWindowAttributes.restype = c_int
        self.x11.XFlush.argtypes = [c_void_p]
        self.x11.XFlush.restype = c_int

        self.xtst.XTestFakeKeyEvent.argtypes = [c_void_p, c_uint, c_int, c_ulong]
        self.xtst.XTestFakeKeyEvent.restype = c_int
        self.xtst.XTestFakeButtonEvent.argtypes = [c_void_p, c_uint, c_int, c_ulong]
        self.xtst.XTestFakeButtonEvent.restype = c_int

    def is_available(self):
        return bool(self.disp and self.root and self.xtst)

    def find_sober_window(self):
        if not self.is_available():
            return None
        root_r = c_ulong()
        parent_r = c_ulong()
        children_r = POINTER(c_ulong)()
        nchildren_r = c_uint()
        status = self.x11.XQueryTree(self.disp, self.root, byref(root_r), byref(parent_r), byref(children_r), byref(nchildren_r))
        if not status or not children_r:
            return None
        sober_win = None
        hint = XClassHint()
        for i in range(nchildren_r.value):
            wid = children_r[i]
            if self.x11.XGetClassHint(self.disp, wid, byref(hint)):
                name = (hint.res_name.decode("utf-8", errors="ignore") if hint.res_name else "").lower()
                cls = (hint.res_class.decode("utf-8", errors="ignore") if hint.res_class else "").lower()
                if "sober" in name or "sober" in cls or "roblox" in name or "roblox" in cls:
                    sober_win = wid
                    break
        if children_r:
            self.x11.XFree(children_r)
        return sober_win

    def get_window_size(self, win):
        if not self.is_available() or not win:
            return 2560, 1440
        attr = XWindowAttributes()
        if self.x11.XGetWindowAttributes(self.disp, win, byref(attr)):
            return max(100, attr.width), max(100, attr.height)
        return 2560, 1440

    def prepare_window(self, win):
        """Warp pointer to window center and focus it inside XWayland."""
        if not self.is_available() or not win:
            return False
        w, h = self.get_window_size(win)
        cx, cy = w // 2, h // 2
        self.x11.XWarpPointer(self.disp, 0, win, 0, 0, 0, 0, cx, cy)
        self.x11.XSetInputFocus(self.disp, win, 1, 0)
        self.x11.XFlush(self.disp)
        # Send a brief click to activate surface in XWayland
        self.click_button(1, press_time=0.04)
        return True

    def click_button(self, button=1, press_time=0.05):
        if not self.is_available():
            return False
        self.xtst.XTestFakeButtonEvent(self.disp, button, 1, 0)
        self.x11.XFlush(self.disp)
        time.sleep(press_time)
        self.xtst.XTestFakeButtonEvent(self.disp, button, 0, 0)
        self.x11.XFlush(self.disp)
        return True

    def tap_key(self, key_name, press_time=0.12):
        if not self.is_available():
            return False
        sym = self.x11.XStringToKeysym(key_name.encode())
        code = self.x11.XKeysymToKeycode(self.disp, sym)
        if not code:
            return False

        self.xtst.XTestFakeKeyEvent(self.disp, code, 1, 0)
        self.x11.XFlush(self.disp)
        time.sleep(press_time)
        self.xtst.XTestFakeKeyEvent(self.disp, code, 0, 0)
        self.x11.XFlush(self.disp)
        return True

    def close(self):
        if self.disp:
            try:
                self.x11.XCloseDisplay(self.disp)
            except Exception:
                pass
            self.disp = None


RUNNING = True

def handle_signal(sig, frame):
    global RUNNING
    print(f"\n[{datetime.now().strftime('%H:%M:%S')}] Остановка Anti-AFK...")
    RUNNING = False

signal.signal(signal.SIGINT, handle_signal)
signal.signal(signal.SIGTERM, handle_signal)

def get_niri_windows():
    try:
        out = subprocess.check_output(['niri', 'msg', '--json', 'windows'], text=True, stderr=subprocess.DEVNULL)
        return json.loads(out)
    except Exception:
        return []

def get_niri_focused_window():
    try:
        out = subprocess.check_output(['niri', 'msg', '--json', 'focused-window'], text=True, stderr=subprocess.DEVNULL)
        return json.loads(out)
    except Exception:
        return None

def find_roblox_niri_window(windows=None):
    if windows is None:
        windows = get_niri_windows()
    for w in windows:
        app_id = (w.get('app_id') or '').lower()
        title = (w.get('title') or '').lower()
        if 'sober' in app_id or 'roblox' in app_id or 'sober' in title or 'roblox' in title:
            return w
    return None

def uinput_tap_key(ui, key_code, press_time=0.14):
    if not ui:
        return
    ui.write(e.EV_KEY, key_code, 1)
    ui.syn()
    time.sleep(press_time)
    ui.write(e.EV_KEY, key_code, 0)
    ui.syn()

def perform_antiafk_routine(x11_sender, x11_win, ui=None, is_focused=False, jump=True, a_duration=None, walk_back=False):
    """
    Выполняет: 1 раз Пробел (Space) + зажатие 'A' на 300-400 мс.
    Отправляет аппаратно через XTest в XWayland без переключения экранов и рабочих столов Niri.
    """
    if a_duration is None:
        a_duration = random.uniform(0.30, 0.40)

    if x11_sender and x11_win:
        # Подготовка: позиционирование курсора и фокусировка окна в XWayland + активация
        x11_sender.prepare_window(x11_win)
        time.sleep(random.uniform(0.06, 0.10))

        # 1. Одно нажатие на Пробел (Space)
        if jump:
            x11_sender.tap_key("space", random.uniform(0.08, 0.12))
            time.sleep(random.uniform(0.08, 0.15))

        # 2. Зажатие клавиши 'a' на 300 - 400 мс
        x11_sender.tap_key("a", a_duration)

        # Опциональный шаг назад ('d'), чтобы не сходить с тренажера/позиции
        if walk_back:
            time.sleep(random.uniform(0.08, 0.15))
            x11_sender.tap_key("d", a_duration)

        return True
    elif ui and is_focused:
        if jump:
            uinput_tap_key(ui, e.KEY_SPACE, random.uniform(0.08, 0.12))
            time.sleep(random.uniform(0.08, 0.15))
        uinput_tap_key(ui, e.KEY_A, a_duration)
        if walk_back:
            time.sleep(random.uniform(0.08, 0.15))
            uinput_tap_key(ui, e.KEY_D, a_duration)
        return True
    return False

def notify(msg):
    try:
        subprocess.run(['notify-send', '-a', 'Roblox Anti-AFK', 'Roblox Anti-AFK', msg], check=False)
    except Exception:
        pass

def parse_time_duration(val):
    if val is None:
        return 300
    if isinstance(val, (int, float)):
        return int(val)
    s = str(val).strip().lower()
    try:
        if s.endswith('m') or s.endswith('мин'):
            clean = s.rstrip('mин')
            return int(float(clean) * 60)
        elif s.endswith('s') or s.endswith('сек') or s.endswith('с'):
            clean = s.rstrip('sекс')
            return int(float(clean))
        elif s.endswith('h') or s.endswith('ч'):
            clean = s.rstrip('hч')
            return int(float(clean) * 3600)
        else:
            return int(float(s))
    except Exception:
        raise argparse.ArgumentTypeError(f"Некорректный формат времени: '{val}'. Пример: 5m, 150s, 300")

def main():
    parser = argparse.ArgumentParser(
        description="Roblox Anti-AFK для Linux (Niri / Sober). Надежно предотвращает 20-минутный кик без переключения рабочих столов и экранов."
    )
    parser.add_argument(
        '-i', '--interval', '-interval',
        type=parse_time_duration,
        default=300,
        help="Базовый интервал (например: 5m, 300s, 300; по умолчанию: 300 сек / 5 мин)"
    )
    parser.add_argument(
        '-r', '--random', '-random',
        type=parse_time_duration,
        default=30,
        help="Случайный разброс времени (например: 30s, 1m; по умолчанию: 30 сек)"
    )
    parser.add_argument(
        '-b', '--bg', '-bg', '--background', '-background',
        dest='allow_bg',
        action='store_true',
        help="Фоновый режим (по умолчанию включен бесшумный фоновый ввод без телепортации окон)"
    )
    parser.add_argument(
        '-j', '--jump', '-jump',
        action='store_true',
        default=True,
        help="Нажимать Пробел (прыжок, включено по умолчанию)"
    )
    parser.add_argument(
        '--no-jump',
        dest='jump',
        action='store_false',
        help="Отключить прыжок (Пробел)"
    )
    parser.add_argument(
        '--walk-back', '--return', '-ret',
        dest='walk_back',
        action='store_true',
        default=False,
        help="После нажатия 'A' нажать 'D' на то же время, чтобы вернуть персонажа на исходную позицию (полезно на узких беговых дорожках)"
    )
    parser.add_argument(
        '-t', '--test', '-test',
        action='store_true',
        help="Выполнить один тестовый цикл прямо сейчас и завершить работу"
    )
    parser.add_argument(
        '-n', '--notify', '-notify',
        action='store_true',
        help="Показывать всплывающее уведомление при каждом цикле Anti-AFK"
    )

    args = parser.parse_args()

    # Инициализируем X11 Sender (XTEST)
    x11_sender = X11InputSender()
    if not x11_sender.is_available():
        print("[!] Внимание: X11/XTEST недоступен. Фоновый ввод может требовать активного окна.")

    # Инициализация виртуальной клавиатуры (uinput)
    ui = None
    if HAVE_UINPUT:
        try:
            capabilities = {
                e.EV_KEY: [e.KEY_W, e.KEY_A, e.KEY_S, e.KEY_D, e.KEY_SPACE]
            }
            ui = UInput(capabilities, name='Roblox-AntiAFK-Virtual')
        except Exception:
            ui = None

    print(f"[{datetime.now().strftime('%H:%M:%S')}] 🎮 Roblox Anti-AFK (XTEST Engine) запущен!")
    print("  Режим: Аппаратный фоновый ввод XTEST (БЕЗ переключения экранов и без телепортации)")
    print(f"  Интервал: ~{args.interval // 60} мин {args.interval % 60} сек (разброс ±{args.random} сек)")
    print(f"  Действие: 1x Space (прыжок) + зажатие 'A' (300-400 мс){' + возврат D' if args.walk_back else ''}")

    # Тестовый запуск
    if args.test:
        roblox_niri = find_roblox_niri_window()
        sober_x11 = x11_sender.find_sober_window()
        
        if not roblox_niri and not sober_x11:
            print("[-] Окно Roblox (Sober) не найдено!")
            if ui: ui.close()
            x11_sender.close()
            return
        
        cur = get_niri_focused_window()
        is_focused = cur and roblox_niri and cur.get('id') == roblox_niri.get('id')
        
        print(f"[*] Выполняем тестовое нажатие Space + A (Фокус Roblox: {'ДА' if is_focused else 'НЕТ (в фоне)'})...")
        perform_antiafk_routine(x11_sender, sober_x11, ui=ui, is_focused=is_focused, jump=args.jump, walk_back=args.walk_back)
        print("[+] Тест успешно выполнен! Окна и фокус НЕ перемещались.")
        if ui: ui.close()
        x11_sender.close()
        return

    # Основной цикл
    try:
        while RUNNING:
            roblox_niri = find_roblox_niri_window()
            sober_x11 = x11_sender.find_sober_window()

            if not roblox_niri and not sober_x11:
                print(f"[{datetime.now().strftime('%H:%M:%S')}] [⏳] Roblox (Sober) не запущен. Ожидание...")
                for _ in range(10):
                    if not RUNNING:
                        break
                    time.sleep(1)
                continue

            cur_focus = get_niri_focused_window()
            is_roblox_focused = (
                cur_focus and roblox_niri and cur_focus.get('id') == roblox_niri.get('id')
            )

            a_time = random.uniform(0.30, 0.40)
            if is_roblox_focused:
                print(f"[{datetime.now().strftime('%H:%M:%S')}] [🕹️] Роблокс в фокусе. Нажатие Space + зажатие 'A' ({int(a_time*1000)} мс)...")
                perform_antiafk_routine(x11_sender, sober_x11, ui=ui, is_focused=True, jump=args.jump, a_duration=a_time, walk_back=args.walk_back)
                if args.notify:
                    notify(f"Anti-AFK: Space + 'A' ({int(a_time*1000)} мс) нажаты!")
            else:
                # Тихо отправляем аппаратно через XTEST без переключения рабочих столов
                print(f"[{datetime.now().strftime('%H:%M:%S')}] [🔄] Роблокс в фоне. Отправка Space + 'A' ({int(a_time*1000)} мс) через XTEST (без перемещения экранов)...")
                perform_antiafk_routine(x11_sender, sober_x11, ui=ui, is_focused=False, jump=args.jump, a_duration=a_time, walk_back=args.walk_back)
                print(f"[{datetime.now().strftime('%H:%M:%S')}] [✅] Нажатия успешно выполнены в фоне. Ваш текущий рабочий стол не прерывался.")
                if args.notify:
                    notify(f"Anti-AFK: фоновые Space + 'A' ({int(a_time*1000)} мс) отправлены!")

            # Вычисляем время до следующего цикла со случайным разбросом
            jitter = random.randint(-args.random, args.random)
            sleep_time = max(30, args.interval + jitter)
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Следующее действие через {sleep_time // 60} мин {sleep_time % 60} сек.\n")

            for _ in range(sleep_time):
                if not RUNNING:
                    break
                time.sleep(1)

    finally:
        if ui:
            ui.close()
        x11_sender.close()
        print(f"[{datetime.now().strftime('%H:%M:%S')}] Anti-AFK завершен. Пока!")

if __name__ == '__main__':
    main()
