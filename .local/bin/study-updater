- [ ] Пройти 10 вопросов в `study-trainer`.
- [ ] Повторить конспект по математике / физике на черновике.
"""
    with open(quest_file, "w", encoding="utf-8") as f:
        f.write(content.strip() + "\n")

def main():
    added, total = update_curriculum()
    update_vault_daily_quest()
    print(f"✅ Обновление завершено! Добавлено {added} новых хардкорных тем. Всего в базе: {total} вопросов.")
    print(f"📁 Создан свежий Daily Tech Quest в Obsidian: ~/Vault/07 🚀 Live Coding Feeds & Daily Quests/")

if __name__ == "__main__":
    main()
