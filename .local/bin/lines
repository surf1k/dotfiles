#!/usr/bin/env python3
"""
lines - Steampunk Phonograph Lyrics Display for CLI
Features:
- Real-time synced lyrics from LRCLIB (with offline cache, Genius fallback & local files)
- Steampunk aesthetic: Emerald (#78c45d) & Gold (#dec07e)
- Smooth animated rotating interlocking Braille gears
- Bold, soft typography with Grand Plaque stage & procedural acoustic waveform
- Steampunk Pressure Manometer, Steam Burst valve [b], and Boiler telemetry
- MPRIS / playerctl integration with playback controls
- Bulletproof anti-aliased viewport rendering with zero border duplication or scroll jitter
"""

import sys
import os
import time
import math
import json
import re
import signal
import select
import termios
import tty
import hashlib
import subprocess
import urllib.request
import urllib.parse
from pathlib import Path

# --- ANSI Styling & Theme Palette ---
RESET = "[0m"
BOLD = "[1m"
DIM = "[2m"
ITALIC = "[3m"

# Palette: Emerald & Gold
GOLD = "[38;2;222;192;126m"        # #dec07e
GOLD_BRIGHT = "[1;38;2;255;235;160m" # #ffeba0
GOLD_MUTED = "[38;2;170;148;95m"    # Faded brass
EMERALD = "[38;2;120;196;93m"      # #78c45d
EMERALD_BRIGHT = "[1;38;2;155;235;125m"
EMERALD_MUTED = "[38;2;90;140;72m"
BORDER_COLOR = "[38;2;95;110;85m"   # Steampunk bronze-slate border
PILL_BG = "[48;2;24;38;20m"        # Soft dark emerald background for active line
DARK_BG = "[48;2;18;26;16m"
STEAM_COLOR = "[38;2;190;215;210m"  # Vapor mist

# Gradients for past lines (fading into dark moss)
PAST_GRADIENT = [
    "[38;2;140;195;120m",  # -1 line
    "[38;2;105;155;92m",   # -2 line
    "[38;2;75;115;68m",    # -3 line
    "[38;2;52;80;48m",     # -4 line
    "[38;2;38;58;35m",     # -5+ line
]

# Gradients for upcoming lines (fading into dark brass)
FUTURE_GRADIENT = [
    "[38;2;210;182;120m",  # +1 line
    "[38;2;165;142;92m",   # +2 line
    "[38;2;125;108;70m",   # +3 line
    "[38;2;90;78;50m",     # +4 line
    "[38;2;65;55;35m",     # +5+ line
]

ANSI_REGEX = re.compile(r'\[[0-9;]*[a-zA-Z]')

def strip_ansi(s):
    return ANSI_REGEX.sub('', s)

def visible_len(s):
    return len(strip_ansi(s))

def truncate_visible(s, max_len):
    """Truncate string s while strictly respecting ANSI sequences so visible length <= max_len."""
    if visible_len(s) <= max_len:
        return s
    res = []
    cur_len = 0
    i = 0
    while i < len(s):
        m = ANSI_REGEX.match(s, i)
        if m:
            res.append(m.group(0))
            i = m.end()
        else:
            if cur_len + 1 > max_len - 1:
                res.append("…")
                res.append(RESET)
                break
            res.append(s[i])
            cur_len += 1
            i += 1
    return "".join(res)

def center_text(s, width):
    vlen = visible_len(s)
    if vlen >= width:
        return truncate_visible(s, width)
    pad = (width - vlen) // 2
    return " " * pad + s + " " * (width - vlen - pad)

# --- Lyrics Cache & Local Storage ---
CACHE_DIR = Path.home() / ".cache" / "lines"
CACHE_DIR.mkdir(parents=True, exist_ok=True)
LOCAL_LYRICS_DIR = Path.home() / ".config" / "lines" / "lyrics"
LOCAL_LYRICS_DIR.mkdir(parents=True, exist_ok=True)

def get_cache_path(artist, title):
    key = f"{artist.strip().lower()}_{title.strip().lower()}"
    h = hashlib.md5(key.encode('utf-8')).hexdigest()
    return CACHE_DIR / f"{h}.json"

def clean_search_term(s):
    if not s:
        return ""
    s = re.sub(r'[\(\[\{].*?[\)\]\}]', '', s)
    s = re.sub(r'\s+-\s+.*$', '', s)
    s = re.sub(r'\s+[fF][eE]?[aA]?[tT]\.?\s+.*$', '', s)
    return s.strip()

def normalize_str(s):
    if not s:
        return ""
    s = s.lower()
    s = re.sub(r'''[()\[\]{}.,;:!?\-_/&+=~`'"«»]''', ' ', s)
    return ' '.join(s.split())

def extract_first_artist(artist_str):
    if not artist_str:
        return ""
    parts = re.split(r'[,;/&+]|\s+и\s+|\s+[fF][eE]?[aA]?[tT]\.?\s+|\s+[xX]\s+|\s+and\s+', artist_str, flags=re.I)
    return parts[0].strip() if parts else artist_str.strip()

def extract_artist_tokens(artist_str):
    raw_parts = re.split(r'[,;/&+]|\s+и\s+|\s+[fF][eE]?[aA]?[tT]\.?\s+|\s+[xX]\s+|\s+and\s+', artist_str, flags=re.I)
    tokens = set()
    for part in raw_parts:
        norm = normalize_str(part)
        if norm:
            tokens.add(norm)
            for w in norm.split():
                if len(w) > 2:
                    tokens.add(w)
    return tokens

def is_artist_match(expected_artist, candidate_artist):
    if not expected_artist or not candidate_artist:
        return False
    exp_norm = normalize_str(expected_artist)
    cand_norm = normalize_str(candidate_artist)
    if exp_norm in cand_norm or cand_norm in exp_norm:
        return True
    exp_tokens = extract_artist_tokens(expected_artist)
    cand_tokens = extract_artist_tokens(candidate_artist)
    return bool(exp_tokens & cand_tokens)

def is_title_match(expected_title, candidate_title):
    if not expected_title or not candidate_title:
        return False
    exp = normalize_str(clean_search_term(expected_title))
    cand = normalize_str(clean_search_term(candidate_title))
    if exp == cand:
        return True
    if exp in cand or cand in exp:
        ratio = min(len(exp), len(cand)) / max(len(exp), len(cand))
        if ratio >= 0.7:
            return True
    return False

def check_local_lyrics(artist, title):
    clean_t = clean_search_term(title)
    first_a = extract_first_artist(artist)
    clean_a = clean_search_term(artist)
    candidates = [
        LOCAL_LYRICS_DIR / f"{first_a} - {clean_t}.lrc",
        LOCAL_LYRICS_DIR / f"{first_a} - {clean_t}.txt",
        LOCAL_LYRICS_DIR / f"{clean_a} - {clean_t}.lrc",
        LOCAL_LYRICS_DIR / f"{clean_a} - {clean_t}.txt",
        LOCAL_LYRICS_DIR / f"{clean_t}.lrc",
        LOCAL_LYRICS_DIR / f"{clean_t}.txt",
    ]
    for p in candidates:
        if p.exists():
            try:
                content = p.read_text(encoding='utf-8').strip()
                if content:
                    is_synced = bool(re.search(r'\[\d{1,2}:\d{2}', content))
                    return {
                        "synced": content if is_synced else None,
                        "plain": content if not is_synced else None,
                        "track": clean_t,
                        "artist": first_a,
                        "source": f"LOCAL ({p.name})"
                    }
            except Exception:
                pass
    return None

def fetch_genius_lyrics(artist, title):
    clean_t = clean_search_term(title)
    clean_a = extract_first_artist(artist) or clean_search_term(artist)
    q = f"{clean_a} {clean_t}"
    url = "https://genius.com/api/search/multi?" + urllib.parse.urlencode({"q": q})
    headers = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:135.0) Gecko/20100101 Firefox/135.0"}
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=4) as r:
            data = json.loads(r.read())
            sections = data.get("response", {}).get("sections", [])
            for sec in sections:
                for hit in sec.get("hits", []):
                    res = hit.get("result", {})
                    h_title = res.get("title", "")
                    h_artist = res.get("primary_artist", {}).get("name", "")
                    h_url = res.get("url", "")
                    if h_url and "lyrics" in h_url:
                        if is_artist_match(artist, h_artist) and is_title_match(title, h_title):
                            page_req = urllib.request.Request(h_url, headers=headers)
                            with urllib.request.urlopen(page_req, timeout=4) as pr:
                                html = pr.read().decode("utf-8", errors="ignore")
                                containers = re.findall(r'<div[^>]*data-lyrics-container="true"[^>]*>(.*?)</div>', html, re.DOTALL)
                                if containers:
                                    raw = "\n".join(containers)
                                    raw = re.sub(r'<br\s*/?>', '\n', raw)
                                    raw = re.sub(r'<.*?>', '', raw)
                                    lines = [l.strip() for l in raw.splitlines() if l.strip()]
                                    if lines:
                                        return {
                                            "synced": None,
                                            "plain": "\n".join(lines),
                                            "track": h_title,
                                            "artist": h_artist,
                                            "source": "GENIUS"
                                        }
    except Exception:
        pass
    return None

def fetch_lyrics(artist, title, duration=0):
    local_res = check_local_lyrics(artist, title)
    if local_res:
        return local_res

    cache_file = get_cache_path(artist, title)
    if cache_file.exists():
        try:
            with open(cache_file, 'r', encoding='utf-8') as f:
                cached = json.load(f)
                c_art = cached.get('artist', '')
                c_trk = cached.get('track', '')
                if is_artist_match(artist, c_art) and is_title_match(title, c_trk):
                    return cached
                else:
                    cache_file.unlink(missing_ok=True)
        except Exception:
            pass

    headers = {'User-Agent': 'lines-phonograph/1.0'}
    clean_t = clean_search_term(title)
    clean_a = clean_search_term(artist)
    first_a = extract_first_artist(artist)

    candidates_search = [
        {"track_name": title, "artist_name": first_a},
        {"track_name": clean_t, "artist_name": first_a},
        {"track_name": clean_t, "artist_name": clean_a},
        {"track_name": title, "artist_name": clean_a},
        {"track_name": title, "artist_name": artist},
        {"q": f"{first_a} {clean_t}"},
        {"q": f"{clean_a} {clean_t}"},
    ]

    for params in candidates_search:
        try:
            url = "https://lrclib.net/api/get?" + urllib.parse.urlencode(params) if "q" not in params else "https://lrclib.net/api/search?" + urllib.parse.urlencode(params)
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=3.5) as response:
                data = json.loads(response.read().decode('utf-8'))
                if isinstance(data, list):
                    matched_items = []
                    for it in data:
                        it_art = it.get('artistName', '')
                        it_trk = it.get('trackName', '')
                        if is_artist_match(artist, it_art) and is_title_match(title, it_trk):
                            matched_items.append(it)
                    item = None
                    if matched_items:
                        synced = [it for it in matched_items if it.get('syncedLyrics')]
                        item = synced[0] if synced else matched_items[0]
                else:
                    item = data
                    it_art = item.get('artistName', '')
                    it_trk = item.get('trackName', '')
                    if not (is_artist_match(artist, it_art) and is_title_match(title, it_trk)):
                        item = None

                if item and (item.get('syncedLyrics') or item.get('plainLyrics')):
                    result = {
                        "synced": item.get('syncedLyrics'),
                        "plain": item.get('plainLyrics'),
                        "track": item.get('trackName', title),
                        "artist": item.get('artistName', artist),
                        "source": "LRCLIB"
                    }
                    try:
                        with open(cache_file, 'w', encoding='utf-8') as f:
                            json.dump(result, f, ensure_ascii=False)
                    except Exception:
                        pass
                    return result
        except Exception:
            continue

    genius_res = fetch_genius_lyrics(artist, title)
    if genius_res:
        try:
            with open(cache_file, 'w', encoding='utf-8') as f:
                json.dump(genius_res, f, ensure_ascii=False)
        except Exception:
            pass
        return genius_res

    return None

def parse_lrc(lrc_text):
    lines = []
    time_tag_pattern = re.compile(r'\[(\d{1,2}):(\d{2}(?:\.\d+)?)\]')
    for raw in lrc_text.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        matches = list(time_tag_pattern.finditer(raw))
        if not matches:
            continue
        text = time_tag_pattern.sub('', raw).strip()
        for m in matches:
            mins = float(m.group(1))
            secs = float(m.group(2))
            total_sec = mins * 60.0 + secs
            lines.append((total_sec, text))
    lines.sort(key=lambda x: x[0])
    return lines

def parse_plain(plain_text, duration):
    raw_lines = [l.strip() for l in plain_text.splitlines() if l.strip()]
    if not raw_lines:
        return []
    step = (duration / len(raw_lines)) if duration > 0 else 4.0
    return [(i * step, text) for i, text in enumerate(raw_lines)]

# --- Steampunk Clockwork Engine (Braille Gears) ---
class SteampunkGears:
    def __init__(self):
        self.size_w = 26
        self.size_h = 8
        self.frames = []
        self.num_frames = 24
        self._generate_frames()

    def _generate_frames(self):
        pix_w = self.size_w * 2
        pix_h = self.size_h * 4
        dot_map = [
            [0x01, 0x08],
            [0x02, 0x10],
            [0x04, 0x20],
            [0x40, 0x80]
        ]
        g1_x, g1_y = 17, 16
        g1_r = 11.5
        g1_teeth = 8
        g1_depth = 3.5

        g2_x, g2_y = 35, 16
        g2_r = 8.5
        g2_teeth = 6
        g2_depth = 3.2

        for f in range(self.num_frames):
            angle = (f / self.num_frames) * (2 * math.pi / g1_teeth)
            g2_angle = -angle * (g1_teeth / g2_teeth) + (math.pi / g2_teeth)

            pixels = [[0] * pix_w for _ in range(pix_h)]
            for y in range(pix_h):
                for x in range(pix_w):
                    dx1 = x - g1_x
                    dy1 = y - g1_y
                    r1 = math.sqrt(dx1*dx1 + dy1*dy1)
                    if r1 <= g1_r + g1_depth + 1:
                        th1 = math.atan2(dy1, dx1) + angle
                        tw1 = math.cos(g1_teeth * th1)
                        lim1 = g1_r + g1_depth * (1.0 if tw1 > 0.25 else (-0.4 if tw1 < -0.25 else tw1))
                        if (r1 <= lim1 and r1 >= g1_r * 0.35) or r1 <= g1_r * 0.18:
                            pixels[y][x] = 1
                            continue

                    dx2 = x - g2_x
                    dy2 = y - g2_y
                    r2 = math.sqrt(dx2*dx2 + dy2*dy2)
                    if r2 <= g2_r + g2_depth + 1:
                        th2 = math.atan2(dy2, dx2) + g2_angle
                        tw2 = math.cos(g2_teeth * th2)
                        lim2 = g2_r + g2_depth * (1.0 if tw2 > 0.25 else (-0.4 if tw2 < -0.25 else tw2))
                        if (r2 <= lim2 and r2 >= g2_r * 0.35) or r2 <= g2_r * 0.18:
                            pixels[y][x] = 2
                            continue

            frame_lines = []
            for ch_y in range(self.size_h):
                line = ""
                for ch_x in range(self.size_w):
                    code = 0x2800
                    val_type = 0
                    for dy in range(4):
                        for dx in range(2):
                            py = ch_y * 4 + dy
                            px = ch_x * 2 + dx
                            p = pixels[py][px]
                            if p:
                                code |= dot_map[dy][dx]
                                val_type = p
                    ch = chr(code)
                    if ch == "⠀":
                        line += " "
                    elif val_type == 1:
                        line += f"{GOLD}{ch}{RESET}"
                    else:
                        line += f"{EMERALD}{ch}{RESET}"
                frame_lines.append(line)
            self.frames.append(frame_lines)

    def get_frame(self, index):
        if not self.frames:
            return []
        return self.frames[index % len(self.frames)]

# --- Terminal Setup & Loop ---
class LinesApp:
    def __init__(self):
        self.running = True
        self.gears = SteampunkGears()
        self.gear_frame_idx = 0
        self.show_gears = True
        
        # Player state
        self.status = "Stopped"
        self.position = 0.0
        self.duration = 0.0
        self.artist = ""
        self.title = ""
        self.album = ""
        self.last_poll_time = time.time()
        
        # Lyrics state
        self.current_song_key = None
        self.lyrics_lines = []
        self.is_synced = False
        self.manual_offset = 0.0
        self.lyrics_loaded = False
        self.lyrics_error = None
        self.single_line_only = True
        
        # Steampunk Steam Burst state
        self.steam_burst_time = 0.0
        
        # Terminal size & state
        self.cols, self.rows = self._get_term_size()
        self.need_clear = True
        self.old_termios = None
        self._setup_terminal()

    def _get_term_size(self):
        try:
            import shutil
            ts = shutil.get_terminal_size((80, 24))
            return max(30, ts.columns), max(10, ts.lines)
        except Exception:
            return 80, 24

    def _setup_terminal(self):
        if sys.stdin.isatty():
            try:
                self.old_termios = termios.tcgetattr(sys.stdin)
                tty.setcbreak(sys.stdin.fileno())
            except Exception:
                pass
        sys.stdout.write("[?1049h[?25l[2J")
        sys.stdout.flush()

    def _restore_terminal(self):
        sys.stdout.write("[?25h[?1049l")
        sys.stdout.flush()
        if self.old_termios and sys.stdin.isatty():
            try:
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_termios)
            except Exception:
                pass

    def handle_resize(self, sig, frame):
        self.cols, self.rows = self._get_term_size()
        self.need_clear = True

    def poll_player(self):
        try:
            out = subprocess.check_output(
                ['playerctl', 'metadata', '--format', '{{status}}	{{position}}	{{mpris:length}}	{{artist}}	{{title}}	{{album}}'],
                text=True, stderr=subprocess.DEVNULL
            ).strip()
            parts = out.split('	')
            if len(parts) >= 5:
                self.status = parts[0]
                pos_raw = float(parts[1]) if parts[1] else 0.0
                self.position = pos_raw / 1_000_000.0
                dur_raw = float(parts[2]) if parts[2] else 0.0
                self.duration = dur_raw / 1_000_000.0
                self.artist = parts[3]
                self.title = parts[4]
                self.album = parts[5] if len(parts) > 5 else ""
                self.last_poll_time = time.time()
                return True
        except Exception:
            self.status = "Stopped"
        return False

    def check_song_change(self):
        song_key = f"{self.artist} - {self.title}"
        if song_key != self.current_song_key and self.title:
            self.current_song_key = song_key
            self.manual_offset = 0.0
            self.lyrics_loaded = False
            self.lyrics_error = None
            self.lyrics_lines = []
            
            res = fetch_lyrics(self.artist, self.title, self.duration)
            if res and (res.get("synced") or res.get("plain")):
                if res.get("synced"):
                    self.lyrics_lines = parse_lrc(res["synced"])
                    self.is_synced = True
                else:
                    self.lyrics_lines = parse_plain(res["plain"], self.duration)
                    self.is_synced = False
                self.lyrics_loaded = True
            else:
                self.lyrics_error = f"⚙ Текст песни не найден: {self.artist} — {self.title}"

    def _edit_lyrics(self):
        if not self.title:
            return
        self._restore_terminal()
        LOCAL_LYRICS_DIR.mkdir(parents=True, exist_ok=True)
        first_a = extract_first_artist(self.artist)
        clean_t = clean_search_term(self.title)
        target = LOCAL_LYRICS_DIR / f"{first_a} - {clean_t}.lrc"
        if not target.exists():
            txt_target = LOCAL_LYRICS_DIR / f"{first_a} - {clean_t}.txt"
            if not txt_target.exists():
                target.write_text(
                    f"# Текст песни: {self.artist} - {self.title}\n"
                    f"# Вставьте строки с таймингами ([00:12.30] Текст) или обычный текст:\n\n",
                    encoding="utf-8"
                )
            else:
                target = txt_target
        editor = os.environ.get("EDITOR") or "nvim"
        try:
            subprocess.run([editor, str(target)])
        except Exception:
            pass
        self._setup_terminal()
        cache_file = get_cache_path(self.artist, self.title)
        if cache_file.exists():
            cache_file.unlink(missing_ok=True)
        self.current_song_key = None

    def handle_input(self):
        while select.select([sys.stdin], [], [], 0)[0]:
            try:
                ch = sys.stdin.read(1)
                if ch in ['q', 'Q', '', '']:
                    self.running = False
                    return
                elif ch == ' ':
                    subprocess.run(['playerctl', 'play-pause'], stderr=subprocess.DEVNULL)
                elif ch in ['n', 'N']:
                    subprocess.run(['playerctl', 'next'], stderr=subprocess.DEVNULL)
                elif ch in ['p', 'P']:
                    subprocess.run(['playerctl', 'previous'], stderr=subprocess.DEVNULL)
                elif ch in ['e', 'E']:
                    self._edit_lyrics()
                elif ch in ['v', 'V']:
                    self.single_line_only = not self.single_line_only
                elif ch in ['b', 'B']:
                    # Steam blow-off valve release!
                    self.steam_burst_time = time.time()
                elif ch == 'g':
                    self.show_gears = not self.show_gears
                elif ch == 'r':
                    if self.artist and self.title:
                        cache_file = get_cache_path(self.artist, self.title)
                        if cache_file.exists():
                            cache_file.unlink(missing_ok=True)
                    self.current_song_key = None
                elif ch in ['+', 'k', 'K']:
                    self.manual_offset -= 1.0
                elif ch in ['-', 'j', 'J']:
                    self.manual_offset += 1.0
                elif ch == '0':
                    self.manual_offset = 0.0
                elif ch == '':
                    seq = sys.stdin.read(2)
                    if seq == '[A':
                        self.manual_offset -= 1.0
                    elif seq == '[B':
                        self.manual_offset += 1.0
            except Exception:
                pass

    def render(self):
        # Prevent terminal autowrap and scrolling by clamping width and line count
        term_w = self.cols
        term_h = self.rows
        
        # Max line width is STRICTLY term_w - 1 (never touch the rightmost terminal column!)
        w = max(38, term_w - 1)
        h = max(10, term_h)

        if self.need_clear:
            sys.stdout.write("[2J[H")
            self.need_clear = False

        # Current effective playback time
        eff_pos = self.position
        if self.status == "Playing":
            eff_pos += (time.time() - self.last_poll_time)
        eff_pos += self.manual_offset
        eff_pos = max(0.0, eff_pos)

        buf = []

        # 1. Header Box
        status_badge = f"{EMERALD_BRIGHT}[ ⏵ PLAYING ]{RESET}" if self.status == "Playing" else f"{GOLD_MUTED}[ ⏸ PAUSED ]{RESET}"
        if self.status == "Stopped":
            status_badge = f"{BORDER_COLOR}[ ⏹ STOPPED ]{RESET}"

        min_cur, sec_cur = divmod(int(eff_pos), 60)
        min_tot, sec_tot = divmod(int(self.duration), 60)
        time_str = f"{min_cur:02d}:{sec_cur:02d} / {min_tot:02d}:{sec_tot:02d}"

        pct = int((eff_pos / self.duration * 100)) if self.duration > 0 else 0
        pct = max(0, min(100, pct))

        # Top border
        header_title = f" ❖ {GOLD}PHONOGRAPH LINES{BORDER_COLOR} ❖ "
        vlen_ht = visible_len(header_title)
        dashes_top = max(2, w - 2 - vlen_ht)
        d_left = 2
        d_right = dashes_top - d_left
        line_top = f"{BORDER_COLOR}╭" + ("─" * d_left) + header_title + ("─" * max(0, d_right)) + f"╮{RESET}"
        buf.append(line_top)

        # Track info line with strict length limits
        right_info = f"{time_str}  {status_badge} "
        right_vlen = visible_len(right_info)
        max_track_vlen = max(12, w - right_vlen - 5)
        
        raw_track = f"{self.title or 'Нет трека'} • {self.artist or 'Ожидание MPRIS...'}"
        styled_track = f" {EMERALD_BRIGHT}{truncate_visible(self.title or 'Нет трека', max_track_vlen // 2)}{RESET} {GOLD_MUTED}•{RESET} {GOLD}{truncate_visible(self.artist or 'Ожидание MPRIS...', max_track_vlen // 2)}{RESET}"
        
        track_vlen = visible_len(styled_track)
        space_count = max(1, w - 2 - track_vlen - right_vlen)
        buf.append(f"{BORDER_COLOR}│{RESET}{styled_track}{' ' * space_count}{right_info}{BORDER_COLOR}│{RESET}")

        # Progress bar line
        bar_len = max(8, min(40, w - 30))
        filled = int(bar_len * (pct / 100.0))
        knob = f"{GOLD_BRIGHT}⚙{RESET}" if self.status == "Playing" else f"{GOLD_MUTED}•{RESET}"
        bar = f"{EMERALD}{'━' * filled}{RESET}{knob}{BORDER_COLOR}{'━' * max(0, bar_len - filled - 1)}{RESET}"
        
        # Steam Pressure Telemetry in Header
        is_steam_burst = (time.time() - self.steam_burst_time) < 2.5
        if is_steam_burst:
            steam_indicator = f"{EMERALD_BRIGHT}💨 [ BLOW-OFF 3.2 BAR ]{RESET}"
        else:
            steam_indicator = f"{GOLD}⚙ [ 2.4 BAR ]{RESET}" if self.status == "Playing" else f"{BORDER_COLOR}⚙ [ 0.0 BAR ]{RESET}"
            
        bar_line = f"  {bar} {GOLD}{pct:3d}%{RESET}   {steam_indicator}"
        space_bar = max(1, w - 2 - visible_len(bar_line))
        buf.append(f"{BORDER_COLOR}│{RESET}{bar_line}{' ' * space_bar}{BORDER_COLOR}│{RESET}")
        buf.append(f"{BORDER_COLOR}╰" + ("─" * (w - 2)) + f"╯{RESET}")

        # 2. Main Area Calculations
        # Reserve: 4 lines (header) + 2 lines (footer) + 1 safety margin = 7 lines
        avail_h = max(4, h - 7)
        split_layout = self.show_gears and (w >= 84) and (avail_h >= 11)
        
        gear_w = 30 if split_layout else 0
        lyrics_w = max(24, w - gear_w - (3 if split_layout else 0))

        # Active lyric calculation
        active_idx = -1
        if self.lyrics_lines:
            for i, (t_sec, _) in enumerate(self.lyrics_lines):
                if t_sec <= eff_pos:
                    active_idx = i
                else:
                    break

        visible_lyrics_lines = []

        if self.single_line_only and self.lyrics_lines:
            # --- GRAND STEAMPUNK LYRIC STAGE ---
            active_text = ""
            if 0 <= active_idx < len(self.lyrics_lines):
                active_text = self.lyrics_lines[active_idx][1].strip()
            if not active_text:
                active_text = "♫  ~  ♫"

            card_w = min(max(32, lyrics_w - 4), 62)
            inner_w = card_w - 6

            # Word wrap within inner_w
            words = active_text.split()
            wrapped_lines = []
            curr = []
            for wd in words:
                curr_len = sum(len(x) for x in curr) + len(curr) + len(wd)
                if curr_len <= inner_w:
                    curr.append(wd)
                else:
                    if curr:
                        wrapped_lines.append(' '.join(curr))
                    # Handle very long words
                    if len(wd) > inner_w:
                        wrapped_lines.append(wd[:inner_w])
                        curr = [wd[inner_w:]]
                    else:
                        curr = [wd]
            if curr:
                wrapped_lines.append(' '.join(curr))
            if not wrapped_lines:
                wrapped_lines = [active_text[:inner_w]]

            # Limit wrapped lines to prevent vertical card overflow
            max_lyr_lines = max(1, avail_h - 7)
            wrapped_lines = wrapped_lines[:max_lyr_lines]

            # Procedural Acoustic Waveform
            chars = [' ', ' ', '▂', '▃', '▄', '▅', '▆', '▇', '█']
            t_now = time.time()
            wave_len = min(card_w - 8, 26)
            wave_chars = []
            for w_i in range(wave_len):
                if self.status == "Playing":
                    v = (math.sin(t_now * 3.8 + w_i * 0.48) + math.cos(t_now * 2.4 - w_i * 0.36) + 2.0) / 4.0
                else:
                    v = (math.sin(w_i * 0.3) + 1.2) / 3.0
                idx = int(v * (len(chars) - 1))
                wave_chars.append(chars[max(0, min(len(chars) - 1, idx))])
            wave_str = ''.join(wave_chars)
            half_w = wave_len // 2
            styled_wave = f"{EMERALD}{wave_str[:half_w]}{GOLD}{wave_str[half_w:]}{RESET}"

            # Plaque top / bottom
            card = []
            card_title = f" {BORDER_COLOR}❖ {GOLD}PHONOGRAM RECORD{BORDER_COLOR} ❖ "
            dashes = max(2, card_w - 2 - visible_len(card_title))
            d_l = dashes // 2
            d_r = dashes - d_l
            card.append(f"{BORDER_COLOR}╭" + ("─" * d_l) + card_title + ("─" * d_r) + f"╮{RESET}")
            
            if avail_h >= 10:
                card.append(f"{BORDER_COLOR}│{' ' * (card_w - 2)}│{RESET}")

            # Render Lyric Lines
            for line in wrapped_lines:
                disp_text = f"« {line} »" if len(wrapped_lines) == 1 else line
                pill_cap_color = "[38;2;28;45;24m"
                pill_bg_color = "[48;2;28;45;24m"
                pill_content = f"{GOLD_BRIGHT}{BOLD}  {disp_text}  {RESET}"
                styled_line = f"{pill_cap_color}{pill_bg_color}{pill_content}{pill_cap_color}{RESET}"
                
                v_len = visible_len(styled_line)
                if v_len > card_w - 4:
                    # Fallback without caps if too wide
                    styled_line = f"{GOLD_BRIGHT}{BOLD} {disp_text} {RESET}"
                    v_len = visible_len(styled_line)
                
                pad = max(0, (card_w - 2 - v_len) // 2)
                r_pad = max(0, card_w - 2 - v_len - pad)
                card.append(f"{BORDER_COLOR}│{RESET}{' ' * pad}{styled_line}{' ' * r_pad}{BORDER_COLOR}│{RESET}")

            if avail_h >= 12:
                card.append(f"{BORDER_COLOR}│{' ' * (card_w - 2)}│{RESET}")
                
            w_pad = max(0, (card_w - 2 - wave_len) // 2)
            w_rpad = max(0, card_w - 2 - wave_len - w_pad)
            card.append(f"{BORDER_COLOR}│{RESET}{' ' * w_pad}{styled_wave}{' ' * w_rpad}{BORDER_COLOR}│{RESET}")

            cur_m, cur_s = int(eff_pos // 60), int(eff_pos % 60)
            tot_m, tot_s = int(self.duration // 60), int(self.duration % 60)
            bot_tag = f" {BORDER_COLOR}⚙ {GOLD}[ {cur_m:02d}:{cur_s:02d} / {tot_m:02d}:{tot_s:02d} ]{BORDER_COLOR} ⚙ "
            b_dashes = max(2, card_w - 2 - visible_len(bot_tag))
            b_l = b_dashes // 2
            b_r = b_dashes - b_l
            card.append(f"{BORDER_COLOR}╰" + ("─" * b_l) + bot_tag + ("─" * b_r) + f"╯{RESET}")

            # Center card in vertical space
            top_pad = max(0, (avail_h - len(card)) // 2)
            visible_lyrics_lines = [""] * top_pad
            for r in card:
                visible_lyrics_lines.append(center_text(r, lyrics_w))
            while len(visible_lyrics_lines) < avail_h:
                visible_lyrics_lines.append("")

        elif self.lyrics_lines:
            # --- FULL STREAM VIEW [v] ---
            half_h = avail_h // 2
            start_i = active_idx - half_h
            end_i = active_idx + half_h + (1 if avail_h % 2 != 0 else 0)

            for i in range(start_i, end_i):
                if i < 0 or i >= len(self.lyrics_lines):
                    visible_lyrics_lines.append("")
                    continue

                t_sec, text = self.lyrics_lines[i]
                diff = i - active_idx

                if diff == 0:
                    pill_cap_color = "[38;2;28;45;24m"
                    pill_bg_color = "[48;2;28;45;24m"
                    pill_inner = f" ✦  {text}  ✦ "
                    styled = f"{pill_cap_color}{pill_bg_color}{GOLD_BRIGHT}{BOLD}{pill_inner}{RESET}{pill_cap_color}{RESET}"
                    visible_lyrics_lines.append(center_text(styled, lyrics_w))
                elif diff < 0:
                    grad_idx = min(len(PAST_GRADIENT) - 1, abs(diff) - 1)
                    styled = f"{PAST_GRADIENT[grad_idx]}{text}{RESET}"
                    visible_lyrics_lines.append(center_text(styled, lyrics_w))
                else:
                    grad_idx = min(len(FUTURE_GRADIENT) - 1, diff - 1)
                    styled = f"{FUTURE_GRADIENT[grad_idx]}{text}{RESET}"
                    visible_lyrics_lines.append(center_text(styled, lyrics_w))

        if not self.lyrics_lines:
            visible_lyrics_lines = [""] * avail_h
            msg = self.lyrics_error or "⚙ Ожидание музыки или текста песни..."
            sub = "Нажмите [e], чтобы добавить текст, [b] - выброс пара" if self.lyrics_error else "Нажмите [Space] Воспроизведение, [b] пар, [r] обновить"
            center_row = max(1, avail_h // 2)
            visible_lyrics_lines[center_row - 1] = center_text(f"{GOLD}{msg}{RESET}", lyrics_w)
            visible_lyrics_lines[center_row] = center_text(f"{GOLD_MUTED}{sub}{RESET}", lyrics_w)

        # Get gear frame
        gear_lines = self.gears.get_frame(self.gear_frame_idx) if split_layout else []
        if self.status == "Playing":
            self.gear_frame_idx += 1

        # Build Left Steampunk Panel
        left_panel = []
        if split_layout:
            # Dynamic steam puff above gears
            is_burst = (time.time() - self.steam_burst_time) < 2.5
            if is_burst:
                steam_hdr = f"{EMERALD_BRIGHT}💨 VAPOR RELEASE{BORDER_COLOR}"
            else:
                puffs = ["~ ° ☁ ~", "° ~ ☁ °", "☁ ~ ° ~", "~ ☁ ° ~"]
                p_idx = int(time.time() * 3) % len(puffs)
                steam_hdr = f"{STEAM_COLOR}{puffs[p_idx]}{BORDER_COLOR}"
                
            left_panel.append(f"{BORDER_COLOR}╭─ {GOLD}⚙ MECHANISM {BORDER_COLOR}─ {steam_hdr} " + ("─" * max(2, gear_w - 24)) + f"╮{RESET}")
            for gl in gear_lines:
                left_panel.append(f"{BORDER_COLOR}│{RESET} {gl} {BORDER_COLOR}│{RESET}")

            # Sub-panel for telemetry
            if avail_h >= 16:
                left_panel.append(f"{BORDER_COLOR}├─ {GOLD}⚙ PHONOGRAPH {BORDER_COLOR}" + ("─" * max(2, gear_w - 17)) + f"┤{RESET}")
                press_val = int(72 + 24 * math.sin(time.time() * 2.2))
                p_bar = "█" * (press_val // 10) + "░" * (10 - (press_val // 10))
                
                stats = [
                    (f"STATE:   {EMERALD}PLAYING ⏵{RESET}" if self.status == "Playing" else f"STATE:   {GOLD_MUTED}PAUSED ⏸{RESET}"),
                    (f"SPEED:   {EMERALD}120 RPM ⚙{RESET}" if self.status == "Playing" else f"SPEED:   {GOLD_MUTED}IDLE 0 RPM{RESET}"),
                    f"VALVES:  {GOLD}[{EMERALD}{p_bar}{GOLD}] {press_val}%{RESET}",
                    f"COGS:    {GOLD}8:6 DUAL MESH{RESET}",
                    f"STYLUS:  {EMERALD}SAPPHIRE 1.8g ❖{RESET}",
                ]
                for st in stats:
                    pad = max(0, gear_w - visible_len(st) - 3)
                    left_panel.append(f"{BORDER_COLOR}│{RESET} {st}{' ' * pad}{BORDER_COLOR}│{RESET}")

                while len(left_panel) < avail_h - 1:
                    left_panel.append(f"{BORDER_COLOR}│{' ' * (gear_w - 2)}│{RESET}")
                left_panel.append(f"{BORDER_COLOR}╰" + ("─" * (gear_w - 2)) + f"╯{RESET}")
            else:
                speed_str = f" {EMERALD}RPM: 120 ⚙{RESET}" if self.status == "Playing" else f" {GOLD_MUTED}IDLE ⚙{RESET}"
                pad = max(0, gear_w - visible_len(speed_str) - 3)
                left_panel.append(f"{BORDER_COLOR}│{RESET}{speed_str}{' ' * pad} {BORDER_COLOR}│{RESET}")
                left_panel.append(f"{BORDER_COLOR}╰" + ("─" * (gear_w - 2)) + f"╯{RESET}")
                while len(left_panel) < avail_h:
                    left_panel.append(" " * gear_w)

        # Assemble Main Frame Lines
        for row_i in range(avail_h):
            lyr = visible_lyrics_lines[row_i] if row_i < len(visible_lyrics_lines) else ""
            if split_layout:
                lp = left_panel[row_i] if row_i < len(left_panel) else (" " * gear_w)
                pad_lp = max(0, gear_w - visible_len(lp))
                line_out = lp + (" " * pad_lp) + f" {BORDER_COLOR}│{RESET} " + lyr
                buf.append(truncate_visible(line_out, w))
            else:
                buf.append(truncate_visible(lyr, w))

        # 3. Footer Control Bar (Strictly 2 separate elements, NO embedded newline)
        buf.append(f"{BORDER_COLOR}" + ("━" * w) + f"{RESET}")
        
        sync_tag = f"{EMERALD}LRC-SYNC{RESET}" if self.is_synced else f"{GOLD_MUTED}AUTO-SCROLL{RESET}"
        offset_tag = f" {GOLD}Offset: {self.manual_offset:+.1f}s{RESET}" if self.manual_offset != 0 else ""
        
        if w >= 80:
            controls = f" {BORDER_COLOR}[{RESET} {GOLD}[Space]{RESET} Play  {GOLD}[n/p]{RESET} Track  {GOLD}[b]{RESET} Steam  {GOLD}[k/j]{RESET} Offset  {GOLD}[e]{RESET} Edit  {GOLD}[v]{RESET} View  {GOLD}[g]{RESET} Gears  {GOLD}[q]{RESET} Quit {BORDER_COLOR}]{RESET}  {sync_tag}{offset_tag}"
        else:
            controls = f" {BORDER_COLOR}[{RESET} {GOLD}[Space]{RESET} {GOLD}[n/p]{RESET} {GOLD}[b]{RESET} {GOLD}[v]{RESET} {GOLD}[q]{RESET} {BORDER_COLOR}]{RESET} {sync_tag}"
            
        space_ctrl = max(1, w - visible_len(controls))
        buf.append(f"{controls}{' ' * space_ctrl}")

        # 4. Atomic Terminal Output
        # Strictly render at most (h - 1) rows so cursor NEVER hits the bottom-right corner and never scrolls!
        max_rows = min(len(buf), h - 1)
        out_lines = []
        for line in buf[:max_rows]:
            out_lines.append(truncate_visible(line, w) + "\033[K")

        sys.stdout.write("\033[H" + "\r\n".join(out_lines))
        sys.stdout.flush()

    def run(self):
        signal.signal(signal.SIGWINCH, self.handle_resize)
        last_poll = 0
        try:
            while self.running:
                now = time.time()
                if now - last_poll >= 0.5:
                    self.poll_player()
                    self.check_song_change()
                    last_poll = now

                self.handle_input()
                self.render()
                time.sleep(0.05)
        finally:
            self._restore_terminal()

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help']:
        print(f"""
{GOLD_BRIGHT}lines{RESET} - Стильный Steampunk Phonograph терминальный плеер текста песен

{EMERALD}Управление:{RESET}
  [Space]               Воспроизведение / Пауза (playerctl)
  [n] / [p]             Следующий / Предыдущий трек
  [b]                   Клапан сброса пара (Steam Blow-off Valve) 💨
  [k] / [j]             Сдвиг синхронизации текста (-1 сек / +1 сек)
  [0]                   Сброс сдвига синхронизации
  [e]                   Редактировать / добавить свой текст песни
  [v]                   Режим отображения (только текущая строка / весь список)
  [g]                   Включить / Выключить вращающиеся шестеренки
  [r]                   Принудительно обновить текст из сети
  [q] / [Esc]           Выход
""")
        return

    app = LinesApp()
    app.run()

if __name__ == '__main__':
    main()
